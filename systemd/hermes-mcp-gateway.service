[Unit]
Description=Hermes MCP Gateway
Wants=network-online.target context-mode.service agent-runtime.service
After=network-online.target context-mode.service agent-runtime.service

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/srv/agents/src/hermes-mcp-gateway
Environment=HOME=/home/user
Environment=HERMES_HOME=/home/user/.hermes
Environment=HERMES_QUIET=1
Environment=HERMES_REDACT_SECRETS=true
Environment=PYTHONPATH=/srv/agents/src/hermes-mcp-gateway/src:/srv/agents/src/hermes-agent
Environment=PATH=/home/user/.local/bin:/home/user/.local/npm/bin:/home/user/.cargo/bin:/home/user/.nix-profile/bin:/opt/node/bin:/opt/flutter/bin:/opt/dotnet:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/agents/telemetry.env
EnvironmentFile=-/etc/agents/hermes.env
EnvironmentFile=-/etc/agents/hermes-headroom.env
EnvironmentFile=-/etc/agents/ilkerce.env
ExecStart=/home/user/.hermes/venvs/hermes/bin/python -m hermes_mcp_gateway.server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
