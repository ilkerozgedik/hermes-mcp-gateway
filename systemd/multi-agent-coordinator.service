[Unit]
Description=Multi-Agent GitHub Issue Coordinator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/srv/agents/src/hermes-mcp-gateway
Environment=HOME=/home/user
Environment=PATH=/home/user/.local/bin:/home/user/.nix-profile/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/srv/agents/src/hermes-mcp-gateway/src
Environment=AGENT_COORDINATOR_DB=/srv/agents/runtime/multi-agent/coordinator.sqlite
Environment=AGENT_COORDINATOR_WORK_ROOT=/home/user/worktrees
Environment=AGENT_COORDINATOR_REPOS_ROOT=/home/user/work
Environment=AGENT_COORDINATOR_REPOS=peacify
ExecStart=/home/user/.hermes/venvs/hermes/bin/python -m hermes_mcp_gateway.coordinator.server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
